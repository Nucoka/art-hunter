{
  "name": "art-hunter",
  "version": "1.0.0",
  "private": true,
  "description": "Десктопный поисковик артов: теги, фильтры, умный поиск, избранное",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ru.arthunter.app",
    "productName": "ArtHunter",
    "files": [
      "main.js",
      "preload.js",
      "providers.js",
      "search-utils.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "artifactName": "ArtHunter-Setup-${version}.${ext}"
    }
  }
}
